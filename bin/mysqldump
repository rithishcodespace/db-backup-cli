#!/bin/bash
if command -v mysqldump.bin >/dev/null 2>&1; then
  exec mysqldump.bin "$@"
elif docker ps --format '{{.Names}}' 2>/dev/null | grep -q test-mysql; then
  exec docker exec -i -e MYSQL_PWD test-mysql mysqldump "$@"
else
  exec docker run --rm -i -e MYSQL_PWD --net=host mysql:8.0 mysqldump "$@"
fi
