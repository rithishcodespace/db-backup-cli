{
  "name": "dbvault",
  "version": "1.0.8",
  "license": "MIT",
  "description": "A production-grade CLI utility to backup and restore databases with Docker runtime",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "dbvault": "bin/dbvault.js"
  },
  "files": [
    "bin",
    "dist",
    "docker-compose.yml",
    "dashboard/dist",
    "generated",
    "scripts/postinstall.js"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "directories": {
    "test": "tests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1071.0",
    "@aws-sdk/s3-request-presigner": "^3.1071.0",
    "@clack/prompts": "^1.7.0",
    "@prisma/client": "^7.8.0",
    "@slack/webhook": "^7.0.9",
    "axios": "^1.18.0",
    "bullmq": "^5.79.2",
    "chalk": "^4.1.2",
    "commander": "^15.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "mongodb": "^7.3.0",
    "mysql2": "^3.24.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.1.1",
    "ora": "^9.4.0",
    "pg": "^8.21.0",
    "rate-limiter-flexible": "^11.2.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.0",
    "valibot": "^1.2.0",
    "winston": "^3.19.0",
    "prisma": "^7.8.0"
  },
  "optionalDependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "better-sqlite3": "^12.10.1"
  },
  "overrides": {
    "js-yaml": "^4.3.2",
    "mysql2": "^3.24.3",
    "deepmerge-ts": "^8.0.2"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^25.9.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/progress": "^2.0.7",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.4.1",
    "fast-check": "^3.23.2",
    "nodemon": "^3.1.14",
    "pm2": "^7.0.1",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "postinstall": "node -e \"try { if (require('fs').existsSync('./scripts/postinstall.js')) require('./scripts/postinstall.js'); } catch {}\"",
    "test": "npm run test:all",
    "build": "tsc",
    "build:all": "prisma generate && tsc && cd dashboard && npm run build",
    "verify:package": "node scripts/verify-package.js",
    "scan:secrets": "node scripts/scan-secrets.js",
    "version:set": "node scripts/set-version.js",
    "version:sync": "node scripts/set-version.js --sync",
    "version:get": "node scripts/set-version.js --get",
    "ci": "npm audit --audit-level=high && npx prisma generate && npx tsc --noEmit && npm run build:all && npm run test:unit && npm run verify:package && npm run scan:secrets",
    "prepack": "prisma generate && tsc && cd dashboard && npm run build",
    "prepublishOnly": "npm run build:all",
    "dev": "nodemon --exec ts-node src/index.ts",
    "start": "node dist/src/server.js",
    "clean": "rm -rf dist",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "services:build": "tsc",
    "services:start": "chmod +x scripts/start-services.sh && ./scripts/start-services.sh",
    "services:stop": "chmod +x scripts/stop-services.sh && ./scripts/stop-services.sh",
    "services:restart": "npm run services:stop && npm run services:start",
    "services:logs": "pm2 logs",
    "services:monit": "pm2 monit",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:build": "docker-compose build",
    "test:unit": "node --test tests/unit/*.test.js tests/unit/commands/*.test.js",
    "test:e2e": "node --test tests/e2e/*.test.js",
    "test:services": "node tests/integration/test-microservices.js",
    "test:all": "npm run test:unit && npm run test:e2e && npm run test:services && npm run test:phase4",
    "test:phase4": "node tests/integration/test-phase4.js",
    "worker": "node dist/src/index.js --worker"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rithishcodespace/db-backup-cli.git"
  },
  "author": "Rithish",
  "bugs": {
    "url": "https://github.com/rithishcodespace/db-backup-cli/issues"
  },
  "homepage": "https://github.com/rithishcodespace/db-backup-cli#readme"
}
