    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "npm run build",
    "postinstall": "prisma generate",
    "services:build": "tsc",
    "services:start": "chmod +x scripts/start-services.sh && ./scripts/start-services.sh",
    "services:stop": "chmod +x scripts/stop-services.sh && ./scripts/stop-services.sh",
    "services:restart": "npm run services:stop && npm run services:start",
    "services:logs": "pm2 logs",
    "services:monit": "pm2 monit",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:build": "docker-compose build",
    "test:services": "node tests/test-microservices.js",
    "test:all": "npm run test:services",
    "test:phase4": "node tests/test-phase4.js"
