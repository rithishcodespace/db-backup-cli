# ==========================================
# Stage 1: Build Node.js TypeScript Backend
# ==========================================
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json prisma.config.ts ./
COPY prisma ./prisma/
RUN npm ci
COPY . .
RUN npx prisma generate
RUN npm run build
RUN npm prune --omit=dev

# ==========================================
# Stage 2: Production Runner
# ==========================================
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV MONGODB_SERVICE_PORT=3012
ENV SERVICE_PORT=3012
ENV BACKUP_PATH=/app/backups

# Install MongoDB database tools (mongodump, mongorestore)
RUN apk add --no-cache mongodb-tools bash ca-certificates

# Copy production artifacts
COPY package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/generated ./generated
COPY --from=builder /app/prisma ./prisma

# Set up runtime directories, symlink, and non-root user permissions
RUN mkdir -p /app/backups /app/logs /app/tmp /root \
    && ln -sfn /app/backups /root/.db-backup \
    && chown -R node:node /app /root \
    && chmod -R 775 /app /root

USER node

EXPOSE 3012

HEALTHCHECK --interval=5s --timeout=3s --start-period=5s --retries=5 \
  CMD node -e "require('http').get('http://localhost:3012/health', (r) => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"

CMD ["node", "dist/src/microservices/database-services/mongodb/service.js"]
