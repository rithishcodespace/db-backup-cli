# ==========================================
# Stage 1: Build Vite React Dashboard
# ==========================================

# Use Node.js 20 running on Alpine Linux as the base image.
# "AS dashboard-builder" gives this build stage a name so we can
# copy files from it into the final image later.
FROM node:20-alpine AS dashboard-builder

# Set /app/dashboard as the working directory inside the container.
# All following commands in this stage will run from this directory.
WORKDIR /app/dashboard

# Copy only the dashboard package files first.
# package.json      -> contains project dependencies and scripts.
# package-lock.json -> locks exact dependency versions.
# Copying these separately improves Docker layer caching.
COPY dashboard/package*.json ./

# Install the dashboard dependencies exactly according to package-lock.json.
# npm ci is preferred for reproducible Docker/CI builds.
RUN npm ci

# Copy the entire React/Vite dashboard source code into the container.
COPY dashboard/ ./

# Build the React/Vite application for production.
# Vite normally generates the production files inside /app/dashboard/dist.
RUN npm run build


# ==========================================
# Stage 2: Build Node.js TypeScript Backend
# ==========================================

# Start a fresh Node.js 20 Alpine image for building the backend.
# This is a separate build stage from the dashboard.
FROM node:20-alpine AS backend-builder

# Set /app as the working directory for the backend.
WORKDIR /app

# Copy backend package files and Prisma configuration.
# package.json      -> dependencies and npm scripts.
# package-lock.json -> exact dependency versions.
# prisma.config.ts  -> Prisma configuration.
COPY package*.json prisma.config.ts ./

# Copy the Prisma directory containing things such as schema.prisma
# and potentially migrations.
COPY prisma ./prisma/

# Install all backend dependencies.
# At this point, both production and development dependencies
# may be installed because we need development tools to build.
RUN npm ci

# Copy the remaining backend source code and project files into /app.
COPY . .

# Generate the Prisma Client/code required by the backend.
# Prisma reads the Prisma schema and generates the required client code.
RUN npx prisma generate

# Compile the TypeScript backend into JavaScript.
# The resulting compiled files are expected under /app/dist.
RUN npm run build

# Remove development-only dependencies after the build is complete.
# The final node_modules will therefore contain only production dependencies.
RUN npm prune --omit=dev


# ==========================================
# Stage 3: Production Runner
# ==========================================

# Start another fresh Node.js 20 Alpine image.
# This is the image that will actually be deployed and run in production.
FROM node:20-alpine AS runner

# Set /app as the working directory of the production container.
WORKDIR /app

# Tell Node.js and libraries that the application is running in production.
ENV NODE_ENV=production

# Set the gateway port used by the application.
ENV GATEWAY_PORT=3000

# Set the general application port.
ENV PORT=3000

# Alpine Linux uses "apk" as its package manager.
# Install CA certificates so the application can make HTTPS requests
# and properly verify SSL/TLS certificates.
# --no-cache prevents apk from keeping its package index locally.
RUN apk add --no-cache ca-certificates


# ==========================================
# Copy Production Artifacts
# ==========================================

# Copy package.json and package-lock.json into the final image.
# These describe the production Node.js application.
COPY package*.json ./

# Copy the node_modules created by the backend-builder stage.
# Since npm prune --omit=dev was run there, these should contain
# only production dependencies.
COPY --from=backend-builder /app/node_modules ./node_modules

# Copy the compiled backend JavaScript from the backend build stage.
# /app/dist in backend-builder -> /app/dist in runner.
COPY --from=backend-builder /app/dist ./dist

# Copy the Prisma generated code from the backend build stage.
# /app/generated -> /app/generated
COPY --from=backend-builder /app/generated ./generated

# Copy the Prisma directory into the final production image.
# This can contain the Prisma schema, migrations, etc.
COPY --from=backend-builder /app/prisma ./prisma

# Copy the production React/Vite build from the dashboard-builder stage.
# dashboard-builder:
#   /app/dashboard/dist
#
# becomes:
#   runner:
#   /app/dashboard/dist
COPY --from=dashboard-builder /app/dashboard/dist ./dashboard/dist


# ==========================================
# Runtime Directories, Symlink & Permissions
# ==========================================

# Create directories required by the application.
#
# /app/data     -> application data
# /app/logs     -> application logs
# /app/tmp      -> temporary files
# /app/backups  -> database backups
# /root         -> root user's home directory
#
# "mkdir -p" also creates parent directories if necessary.
RUN mkdir -p /app/data /app/logs /app/tmp /app/backups /root \

    # Create/update a symbolic link:
    #
    # /root/.db-backup
    #       |
    #       v
    # /app/backups
    #
    # This means accessing /root/.db-backup actually accesses /app/backups.
    #
    # -s  -> create symbolic link
    # -f  -> replace an existing destination if necessary
    # -n  -> treat an existing symlink as a link rather than following it
    && ln -sfn /app/backups /root/.db-backup \

    # Change ownership of /app and /root recursively.
    #
    # node:node means:
    #   owner = node
    #   group = node
    #
    # This is important because the container will later run as
    # the non-root "node" user.
    && chown -R node:node /app /root \

    # Recursively give:
    #
    # Owner  -> read + write + execute
    # Group  -> read + write + execute
    # Others -> read + execute
    #
    # 7 = read + write + execute
    # 5 = read + execute
    #
    # -R means apply this recursively to everything under /app and /root.
    && chmod -R 775 /app /root


# Switch from root to the built-in non-root "node" user.
# Running applications as a non-root user improves container security.
USER node


# Document that the application listens on port 3000.
# EXPOSE does not publish the port to the host by itself.
# For example, Docker can publish it with: -p 3000:3000
EXPOSE 3000


# ==========================================
# Container Health Check
# ==========================================

# Docker periodically checks whether the application is healthy.
#
# --interval=5s
#   Run the health check every 5 seconds.
#
# --timeout=3s
#   Allow up to 3 seconds for the health check.
#
# --start-period=5s
#   Give the application 5 seconds to start before counting failures.
#
# --retries=5
#   After 5 consecutive failures, Docker marks the container unhealthy.
#
# The command sends an HTTP request to:
#   http://localhost:3000/health
#
# If the endpoint returns HTTP 200 -> success.
# Any other status code or connection error -> failure.
HEALTHCHECK --interval=5s --timeout=3s --start-period=5s --retries=5 \
  CMD node -e "require('http').get('http://localhost:3000/health', (r) => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"


# ==========================================
# Start Application
# ==========================================

# Define the default command that runs when the container starts.
#
# node
#   -> Node.js runtime
#
# dist/src/microservices/gateway/index.js
#   -> compiled backend entry point
#
# Therefore the container starts the Node.js gateway on port 3000.
CMD ["node", "dist/src/microservices/gateway/index.js"]


# ==========================================
# FINAL IMAGE STRUCTURE
# ==========================================

# The first two stages are BUILD-ONLY stages.
#
# Dashboard Builder
#   ├── React source code
#   ├── Vite
#   ├── dashboard dependencies
#   └── dashboard/dist          <-- production frontend
#
# Backend Builder
#   ├── TypeScript source
#   ├── Prisma
#   ├── TypeScript compiler
#   ├── backend dependencies
#   ├── generated Prisma client
#   └── dist                    <-- compiled backend
#
#
# Only the required artifacts are copied into the FINAL IMAGE.
#
# Runner
#   ├── dist/                   <-- compiled backend
#   ├── generated/              <-- generated Prisma code
#   ├── prisma/                 <-- Prisma files
#   ├── dashboard/
#   │   └── dist/               <-- compiled React frontend
#   ├── node_modules/           <-- production dependencies only
#   ├── data/
#   ├── logs/
#   ├── tmp/
#   └── backups/
#
# The final container runs:
#
#   node dist/src/microservices/gateway/index.js
#
# as the non-root "node" user on port 3000.

  #                   docker build
  #                        │
  #         ┌──────────────┴──────────────┐
  #         │                             │
  #         ▼                             ▼
  #  dashboard-builder             backend-builder
  #         │                             │
  #    React + Vite                 TypeScript
  #         │                         Prisma
  #    npm run build              npm run build
  #         │                             │
  #         ▼                             ▼
  #  dashboard/dist                  dist/
  #         │                       generated/
  #         │                       prisma/
  #         │                       node_modules/
  #         │                             │
  #         └──────────────┬──────────────┘
  #                        ▼
  #                      runner
  #                        │
  #            ┌───────────┴───────────┐
  #            │                       │
  #       React dist              Backend dist
  #            │                       │
  #            └───────────┬───────────┘
  #                        ▼
  #                 Node Gateway
  #                     :3000