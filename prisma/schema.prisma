// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model BackupJob {
  id          String   @id @default(cuid())
  dbType      String
  dbName      String
  backupType  String   // full, incremental, differential
  status      String   // pending, running, success, failed, cancelled
  
  // File information
  filePath    String?
  fileName    String?
  fileSize    Int?
  compressedSize Int?
  checksum    String?
  
  // Backup metadata
  baseBackupId String?
  parentBackupId String?
  backupLevel   Int?
  
  // Database-specific tracking
  walPosition    String?
  binlogFile     String?
  binlogPosition Int?
  oplogTimestamp String?
  
  // Backup name
  backupName    String?
  
  // Timing
  startedAt   DateTime @default(now())
  completedAt DateTime?
  duration    Int?
  expiresAt   DateTime?
  
  // Storage
  storageType  String @default("local")
  storagePath  String?
  storageRegion String?

  // Storage relation
  storageLocationId  String?           @map("storageLocationId")
  storageLocation    StorageLocation?  @relation(fields: [storageLocationId], references: [id], onDelete: SetNull)
  
  // Additional
  compressionType String?
  encryptionType  String?
  backupVersion   String?
  retryCount     Int @default(0)
  error          String?
  metadata       Json?
  
  // Relationships
  logs          BackupLog[]
  notifications Notification[]
  
  @@index([status])
  @@index([startedAt])
  @@index([dbType])
  @@index([dbName])
  @@index([baseBackupId])
  @@index([storageType])
  @@index([expiresAt])
}

model BackupSchedule {
  id          String   @id @default(cuid())
  name        String
  dbType      String
  dbName      String
  schedule    String   // Cron expression
  backupType  String   // full, incremental, differential
  
  // Options
  compress    Boolean  @default(true)
  storageType String   // local, s3,
  retention   Int?
  enabled     Boolean  @default(true)
  
  // Notification settings
  notifyOnSuccess Boolean @default(false)
  notifyOnError   Boolean @default(true)
  slackWebhook    String?
  emailRecipients String?
  
  // Metadata
  metadata    Json?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  lastRunStatus String?
  error       String?
  
  @@index([enabled])
  @@index([nextRunAt])
}

model BackupLog {
  id          Int      @id @default(autoincrement())
  backupJobId String
  timestamp   DateTime @default(now())
  level       String
  message     String
  details     String?
  backupJob   BackupJob @relation(fields: [backupJobId], references: [id], onDelete: Cascade)
  
  @@index([backupJobId])
  @@index([timestamp])
}

model Notification {
  id          String   @id @default(cuid())
  backupJobId String?
  type        String
  status      String
  recipient   String?
  subject     String?
  message     String?
  sentAt      DateTime?
  error       String?
  createdAt   DateTime @default(now())
  retryCount  Int     @default(0)
  backupJob   BackupJob? @relation(fields: [backupJobId], references: [id], onDelete: SetNull)
  
  @@index([status])
  @@index([createdAt])
}

model StorageLocation {
  id          String   @id @default(cuid())
  name        String   @unique
  type        String   // local, s3
  config      Json?
  
  // S3 specific
  bucket      String?
  region      String?
  accessKey   String?
  secretKey   String?
  
  enabled     Boolean  @default(true)
  default     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  backupJobs  BackupJob[]
  
  @@index([type])
  @@index([enabled])
}

// Notification Configuration Model
model NotificationConfig {
  id          String   @id @default(cuid())
  type        String   // email, slack
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Email specific
  smtpHost    String?
  smtpPort    Int?
  smtpUser    String?
  smtpPassword String?
  from        String?
  
  // Slack specific
  webhook     String?
  
  @@unique([type])
  @@index([type])
  @@index([enabled])
}