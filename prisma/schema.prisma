// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model BackupJob {
  id          String   @id @default(cuid())
  dbType      String
  dbName      String
  backupType  String   // full, incremental, differential
  status      String   // pending, running, success, failed, cancelled
  
  // File information
  filePath    String?
  fileName    String?
  fileSize    Int?
  compressedSize Int?
  checksum    String?
  
  // Backup metadata
  baseBackupId String?  // For incremental/differential - ID of base backup
  parentBackupId String? // For incremental chain
  backupLevel   Int?    // 0=full, 1=incremental, 2=differential
  
  // NEW: Database-specific tracking (for future incremental implementation)
  walPosition    String?  // PostgreSQL WAL position
  binlogFile     String?  // MySQL binlog file
  binlogPosition Int?     // MySQL binlog position
  oplogTimestamp String?  // MongoDB oplog timestamp
  
  // NEW: Backup name for easier identification
  backupName    String?   // User-friendly backup name
  
  // Timing
  startedAt   DateTime @default(now())
  completedAt DateTime?
  duration    Int?     // in seconds
  expiresAt   DateTime? // For retention policies
  
  // Storage
  storageType  String @default("local") // local, s3
  storagePath  String?
  storageRegion String?

  // Storage relation
  storageLocationId  String?           @map("storageLocationId")
  storageLocation    StorageLocation?  @relation(fields: [storageLocationId], references: [id], onDelete: SetNull)
  
  // Additional
  compressionType String? // gzip, zstd, none
  encryptionType  String? // aes256, none
  backupVersion   String?
  retryCount     Int @default(0)
  error          String?
  metadata       Json?   // JSON for flexible storage
  
  // Relationships
  logs          BackupLog[]
  notifications Notification[]
  
  @@index([status])
  @@index([startedAt])
  @@index([dbType])
  @@index([dbName])
  @@index([baseBackupId])
  @@index([storageType])
  @@index([expiresAt])
}

model BackupSchedule {
  id          String   @id @default(cuid())
  name        String
  dbType      String
  dbName      String
  schedule    String   // Cron expression
  backupType  String   // full, incremental, differential
  
  // Options
  compress    Boolean  @default(true)
  storageType String   // local, s3,
  retention   Int?     // Days to keep backups
  enabled     Boolean  @default(true) // backup scheduled is active or inactive
  
  // Notification settings
  notifyOnSuccess Boolean @default(false)
  notifyOnError   Boolean @default(true)
  slackWebhook    String? // webhook url for each user's workspace
  emailRecipients String?  // Comma-separated emails
  
  // Metadata
  metadata    Json?     // JSON for flexible storage
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  lastRunStatus String?
  error       String?
  
  @@index([enabled])
  @@index([nextRunAt])
}

model BackupLog {
  id          Int      @id @default(autoincrement())
  backupJobId String
  timestamp   DateTime @default(now())
  level       String   // info, warn, error, debug
  message     String
  details     String?  // JSON string
  backupJob   BackupJob @relation(fields: [backupJobId], references: [id], onDelete: Cascade)
  
  @@index([backupJobId])
  @@index([timestamp])
}

model Notification {
  id          String   @id @default(cuid())
  backupJobId String?
  type        String   // slack, email, webhook
  status      String   // pending, sent, failed
  recipient   String?
  subject     String?
  message     String?
  sentAt      DateTime?
  error       String?
  createdAt   DateTime @default(now())
  retryCount  Int     @default(0)
  backupJob   BackupJob? @relation(fields: [backupJobId], references: [id], onDelete: SetNull)
  
  @@index([status])
  @@index([createdAt])
}

model StorageLocation {
  id          String   @id @default(cuid())
  name        String   @unique
  type        String   // local, s3
  config      Json?    // Storage-specific configuration
  
  // S3 specific
  bucket      String?
  region      String?
  accessKey   String?
  secretKey   String?
  
  enabled     Boolean  @default(true)
  default     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  backupJobs  BackupJob[]
  
  @@index([type])
  @@index([enabled])
}